# Required for free-text shopping discovery. Without Gemini, only exact validated
# cache hits and controlled quick replies can advance; Choosy never fabricates.
GEMINI_API_KEY=
# The production path is intentionally pinned in code to gemini-3.5-flash-lite.

# Demo merchant access code.
CHOOSY_OPERATOR_ACCESS_CODE=admin
CHOOSY_SESSION_SECRET=

# Optional Razorpay Test Mode integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required by POST /api/commerce/checkouts. Local default: choosy-agent-demo.
COMMERCE_AGENT_API_KEY=

# Production-shaped persistence. Without these values, local development uses an
# atomic JSON-file repository in the operating-system temporary directory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Set after migration 004 is applied when testing durable persistence locally.
USE_SUPABASE_COMMERCE=false

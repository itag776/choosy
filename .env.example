# Required for the real OpenAI agent. The app uses a labelled deterministic fallback without it.
OPENAI_API_KEY=
# The production path is intentionally pinned in code to gpt-5.4-mini-2026-03-17.

# Required in production. Generate a random 32+ character session secret and choose
# a private 12+ character access code for buildathon judges/operators. Local development defaults
# to the visibly documented access code `recoveros-demo`; production fails closed.
RECOVEROS_OPERATOR_ACCESS_CODE=
RECOVEROS_SESSION_SECRET=

# Optional Razorpay Test Mode integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production-shaped persistence. Without these values, local development uses an
# atomic JSON-file repository in the operating-system temporary directory.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

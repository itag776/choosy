# Required for the real OpenAI agent. The app uses a labelled deterministic fallback without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional Razorpay Test Mode integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional persistent store. The hackathon demo works with its in-memory store by default.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
